{
  "manifest_version": 3,
  "name": "PS Assist — richieste Pronto Soccorso",
  "short_name": "PS Assist",
  "version": "3.30.1",
  "description": "Crea richieste lab/radiologia su SA4PSO e aggiunge gli esami scelti, verificando ogni inserimento nel carrello. La Conferma resta sempre un click reale sulla pagina.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://smarthealth.multimedica.it/sa4pso/*",
        "http://10.11.0.151/clin-port/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "options_ui": {
    "page": "portale.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://smarthealth.multimedica.it/*",
    "http://10.11.0.151/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "consensi/*.pdf"
      ],
      "matches": [
        "https://smarthealth.multimedica.it/*"
      ]
    }
  ]
}
