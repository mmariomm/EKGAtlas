{
  "name": "ekg-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive ED-EKG atlas — vector-driven 12-lead waveform synthesis with synchronized conduction animation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm test/engine.test.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "wrangler": "^4.98.0"
  }
}
