{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ekg-atlas",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ponte/*",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PONTE",
        "class_name": "PonteStanza"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ponte-v1",
      "new_sqlite_classes": [
        "PonteStanza"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
