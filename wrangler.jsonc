{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ekg-atlas",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      // no per-request log lines: a bridge URL carries its room id
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/ponte/*",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PONTE",
        "class_name": "PonteStanza"
      },
      {
        // the PS Assist PC registry (⋯ → Dispositivi): one object, «registro»
        "name": "REGISTRO",
        "class_name": "PonteRegistro"
      },
      {
        // the doctor's encrypted «Da rivedere» pins: one object per opaque id
        "name": "APPUNTI",
        "class_name": "PonteAppunti"
      }
    ]
  },
  "migrations": [
    {
      "tag": "ponte-v1",
      "new_sqlite_classes": [
        "PonteStanza"
      ]
    },
    {
      "tag": "registro-v1",
      "new_sqlite_classes": [
        "PonteRegistro"
      ]
    },
    {
      "tag": "appunti-v1",
      "new_sqlite_classes": [
        "PonteAppunti"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
